# --- Public (browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_R2_PUBLIC_URL=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_PLAN_ID=
# Responsive AdSense unit for the 8-track ad break
NEXT_PUBLIC_ADSENSE_BREAK_SLOT=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# Supabase → Project Settings → API Keys → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=
# Admin panel login (/sa-login). Pick a NEW password.
ADMIN_EMAIL=4andonestudio@gmail.com
ADMIN_PASSWORD=
# Optional: separate secret for signing the admin session cookie
ADMIN_SESSION_SECRET=
# PayPal → Developer Dashboard → Apps & Credentials (Live) → Secret
PAYPAL_CLIENT_SECRET=
# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
# Telegram login bot token (@BotFather → the bot in NEXT_PUBLIC_TELEGRAM_BOT_NAME).
# Lets the server verify Telegram logins, so each listener can read only their
# OWN history/profile. Without it the old open "?tid=" lookups stay on.
TELEGRAM_BOT_TOKEN=
# Optional: if the Telegram Mini App (bot menu button) is a DIFFERENT bot than
# the login bot, put that bot's token here too (or list both, comma-separated,
# in TELEGRAM_BOT_TOKEN).
TELEGRAM_WEBAPP_BOT_TOKEN=
CRON_SECRET=
